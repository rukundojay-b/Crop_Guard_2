# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
# Postgres 14+ . The migration script creates the schema on first run.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cropguard
# Set to "true" when your provider requires TLS (Neon, Supabase, RDS, Render).
DATABASE_SSL=false

# ---- Auth ----
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# They MUST be different from each other and must never be committed.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Cookie domain for the refresh token. Leave blank for localhost.
COOKIE_DOMAIN=

# ---- Gemini ----
# This key stays on the server and is never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-2.5-flash

# ---- Limits ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=6291456
MAX_MESSAGES_PER_DAY=120
MAX_CONVERSATION_TURNS=40
